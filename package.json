{
  "name": "optiscaler-gui",
  "private": true,
  "version": "0.1.0",
  "license": "0BSD",
  "description": "Electron app for discovering games and automating OptiScaler installation.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 dist/main/main.js && electron .\"",
    "build": "npm run generate:icon && vite build && tsc -p tsconfig.main.json && electron-builder --win portable --publish never --config.win.signAndEditExecutable=false",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "dist": "npm run generate:icon && electron-builder --win portable --publish never --config.win.signAndEditExecutable=false",
    "generate:icon": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-icon.ps1 && node ./scripts/convert-icon.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.optiscaler.gui",
    "productName": "OptiScaler GUI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
